#!/bin/sh

preview_text() {
    if command -v bat >/dev/null 2>&1; then
        highlighter=bat
    elif command -v batcat >/dev/null 2>&1; then
        highlighter=batcat
    else
        exec head -n "$height" -- "$@"
    fi

    exec "$highlighter" --color=always --theme=ansi --style=plain \
        --paging=never --wrap=never --line-range="1:$height" \
        --file-name="$path" -- "$@"
}

path=$1
height=$3

mime_type=$(file -bL --mime-type -- "$path" 2>/dev/null) || mime_type=
case "$mime_type" in
    image/*) exit 0 ;;
esac

size=$(stat -Lc %s -- "$path" 2>/dev/null) || size=0
if [ "$size" -gt 1048576 ]; then
    head -c 16384 -- "$path" | preview_text
    exit $?
fi

if [ "$mime_type" = application/pdf ]; then
    if command -v pdftotext >/dev/null 2>&1; then
        pdftotext -f 1 -l 1 -nopgbrk -- "$path" - 2>/dev/null | head -n "$height"
    else
        printf '%s\n' 'PDF previews require Poppler.'
    fi
    exit 0
fi

preview_text "$path"
